{
  "name": "efootball-scraper",
  "version": "1.0.0",
  "description": "eFootbase API Scraper — Web dashboard + API để cào và quản lý dữ liệu cầu thủ eFootball",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "scrape": "node src/scraper.js",
    "scrape:resume": "node src/scraper.js --resume",
    "scrape:retry": "node src/scraper.js --retryFailed",
    "status": "node src/status.js",
    "export": "node src/export.js"
  },
  "dependencies": {
    "mongodb": "^6.21.0"
  }
}
